# Clés fournisseur : côté serveur uniquement, jamais préfixées NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Facultatif : URL publique envoyée à OpenRouter comme métadonnée.
APP_PUBLIC_URL=

# À ajouter lorsque l'authentification et la base de données seront intégrées.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clé séparée pour le chiffrement authentifié des secrets persistés.
APP_ENCRYPTION_KEY=
