# Fournisseurs IA : secrets côté serveur uniquement, jamais préfixés NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# URL publique envoyée à OpenRouter comme métadonnée.
APP_PUBLIC_URL=

# Supabase : URL serveur et clés publiques/privées selon usage.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Jeton temporaire de provisionnement admin pour créer une clé Bickri.
# Génère un secret long et aléatoire. Ne le mets jamais dans le frontend.
BICKRI_ADMIN_SETUP_TOKEN=

# Réservée à l'intégration future du chiffrement des identifiants fournisseurs.
APP_ENCRYPTION_KEY=
