# Ne jamais committer de vraies valeurs de secrets.
# Génération de clés non authentifiées : laisser désactivée en production.
BICKRI_ALLOW_UNAUTHENTICATED_KEY_CREATION=false

# À configurer lors de l'intégration de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# À ajouter côté serveur pour le chiffrement authentifié des secrets fournisseur.
APP_ENCRYPTION_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=